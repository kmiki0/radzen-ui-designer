// Cloudflare Pages に公開する設定。
// 先に `dotnet publish RadzenUiDesigner -c Release -o publish -p:CompressionEnabled=false` で
// publish/wwwroot を作ってから `npx wrangler pages deploy --branch=main` する。
// 404.html を置いていないので、存在しないパスには index.html を返し、Blazor 側のルーティングに任せる。
{
  "name": "radzen-ui-designer",
  "compatibility_date": "2026-09-01",
  "pages_build_output_dir": "./publish/wwwroot"
}
